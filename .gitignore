# Standard Pitchfork .gitignore
build

# External source code
external/*/*

# Generated binary content
*.pdf
*.eps
*.gif
*.png
*.cgns
*.cgn
*.hdf5
*.hdf

# Old, temporary, local, and extra files
*.old
old.*
*.new
new.*
*.tmp
tmp.*
*.bad
bad.*
*.bak
bak.*
*.local
local.*

# Stray stdout, stderr, and log files
*.out
*.err
*.log

# Documents in development
*.lyx
*.odg
*.ods

# valgrind suppression files are machine-specific
*.supp

# CI/CD stuff
*.yml

# Folders & FILES
.venv/
research-notes/femera-v0.1/
research-notes/femera-v0.2/
research-notes/femera-prior-work/figs/
research-notes/femera-prior-work/data/
research-notes/femera-prior-work/femera-v0.1-tm-DRAFT-2026-01-25.tex


# Auto-created directories and files
.venv*
.vscode*
*.kate-swp
*.lyx~
*.lyx#
*.ods#
*.emergency
*.tex~
*.pyc
__pycache__/
*.py[cod]
*$py.class
cython_debug/
*.gcda
.goutputstream-*
*.core.*
vgcore.*
