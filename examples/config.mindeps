#!/usr/bin/make
# config.local
#
# Please update the next line with your name, affiliation, and email address.
BUILT_BY:=Anonymous Developer (Example University)<dev@example.edu>
#
# Set PREFIX to the full path of a user-writable installation directory.
PREFIX:=/home/dev/.local
#
# Please review NOSA-1.3.txt Section 3D before adding a copyright notice.
CONTRIBUTOR_COPYRIGHT_FILE:=COPYRIGHT.contrib.txt
#
FMR_VERBMAX:=5

# Use parallel make jobs
ENABLE_MAKEJOBS:=ON

# Libraries needed ------------------------------------------------------------
ENABLE_OMP:=ON
ENABLE_MPI:=OFF

#TODO use hwloc installed by PETSc instead of libnuma?
ENABLE_PETSC_HWLOC:=OFF
ENABLE_LIBNUMA:=OFF
# NOTE libnuma is LGPL; replace with hwloc (BSD license)

# External packages -----------------------------------------------------------
ENABLE_BATS:=ON
ENABLE_PYBIND11:=OFF

ENABLE_GMSH:=OFF
ENABLE_GMSH_OMP:=OFF
ENABLE_GMSH_METIS:=OFF
ENABLE_FLTK:=OFF
ENABLE_NEPER:=OFF
ENABLE_POVRAY:=OFF

# External packages downloaded and installed by PETSc -------------------------
ENABLE_OCCT:=OFF
ENABLE_GOOGLETEST:=ON
ENABLE_HDF5:=OFF

ENABLE_PETSC:=OFF
ENABLE_PETSC_DEBUG:=OFF

ENABLE_PETSC_MPI:=OFF

ENABLE_PETSC_BLASLAPACK:=OFF
ENABLE_PETSC_OMP:=OFF
ENABLE_PETSC_ZIPLIBS:=OFF
ENABLE_PETSC_IMAGELIBS:=OFF
ENABLE_PETSC_X:=OFF

ENABLE_NVIDIA:=OFF
ENABLE_PETSC_NVIDIA:=OFF
ENABLE_PETSC_EIGEN:=OFF

ENABLE_PETSC_MPI4PY:=OFF
ENABLE_PETSC4PY:=OFF

#Note GPL2+ ENABLE_PETSC_FFTW:=ON 

# File formats
ENABLE_CGNS:=OFF
ENABLE_PETSC_MOAB:=OFF
ENABLE_PETSC_PNETCDF:=OFF
ENABLE_PETSC_EXODUSII:=OFF

# PDE solver with adaptive mesh refinement (future expansion)
#Note LGPL2.1 ENABLE_PETSC_LIBMESH:=OFF

# Partitioners
#NOTE PARMETIS is for nonprofit research or evaluation use only.
ENABLE_PETSC_PARMETIS:=OFF
ENABLE_PETSC_CHACO:=OFF
ENABLE_PETSC_SCOTCH:=OFF

# Multilevel preconditioning
ENABLE_PETSC_ML:=OFF

# Developer tools -------------------------------------------------------------
ENABLE_VALGRIND:=ON

ENABLE_LYX:=ON
ENABLE_DOT:=ON
ENABLE_DOT_PNG:=ON


