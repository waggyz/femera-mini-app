{ "fmr:Sims": [ {
  "fmr:NOTE": "non-fmr: keys imply Python shared values and parameters.",

  "fmr:Name": "Cantilever beam sims (uq_straw_1.json)",
  "fmr:Version": "0.1.6",
  "fmr:Sims_application": "fmr:UQ",
  "fmr:Geom": [{
    "fmr:Geometry_shape": "fmr:Block",
    "fmr:Dimensions_xyz": {"beam_dimensions": [1.000, 0.050, 0.050] },
    "fmr:NOTE": "Using beam_dimensions for testing; could use fmr:Dimension_x,..."
  },{
    "fmr:File_name": "uq_straw_1.geo",
    "fmr:Parameter": {"beam_dimensions": [1.000, 0.050, 0.050] }
  }],
  "fmr:Grid": [{
    "fmr:Geom": 0,
    "fmr:Grid_structure": "fmr:Rectilinear",
    "fmr:Grid_divs": [100, 5, 5],
    "fmr:Cell_type": "fmr:Block_6tet",
    "fmr:Elem_type": "fmr:Tet10",
    "fmr:Node_set": [
      {"beam-base-nodeset": {"fmr:Node_at": "fmr:Node_x_min" }},
      {"beam-tip-nodeset": {"fmr:Node_at": "fmr:Node_x_max" }}
    ],
    "node_number": "fmr:Node_id",
    "nominal_coordinates": "fmr:Node_xyz",
    "beam_volume": "fmr:Volume"
  },{
    "fmr:Geom": 1,
    "fmr:Node_set": [
      {"beam-base-nodeset": {"fmr:Node_at": "fmr:Node_x_min" }},
      {"beam-tip-nodeset": {"fmr:Node_at": "fmr:Node_x_max" }}
    ],
    "node_number": "fmr:Node_id",
    "nominal_coordinates": "fmr:Node_xyz",
    "beam_volume": "fmr:Volume"
  }],
  "fmr:Part": [{
    "fmr:Grid": [0,1],
    "fmr:Part_method": "fmr:Single",
    "fmr:Part_n": 1
  }],
  "fmr:Mtrl": [{
    "fmr:Name": "Basic steel",
    "fmr:Mtrl_physics": "fmr:Elastic_isotropic",
    "fmr:Youngs_modulus": {"youngs": 210e9},
    "fmr:Poissons_ratio": {"poissons": 0.285}
  }],
  "fmr:BCs": [{ 
    "fmr:Name": "Encastre the beam's base.",
    "fmr:Node_set": "beam-base-nodeset",
    "fmr:Displacement_xyz": [0.000, 0.000, 0.000]
    },{ 
    "fmr:Name": "Displace the beam's free end face.",
    "fmr::Data_type:Node_set": "beam-tip-nodeset",
    "fmr:Displacement_z": {"tip_displace_z": -0.010}
  }],
  "fmr:Solve": [{
    "fmr:Name": "Solve nominal beam.",
    "fmr:Analysis": "fmr:Static",
    "fmr:Conditioner": "fmr:Jacobi",
    "fmr:Solver": "fmr:PCG",
    "nominal_displacements": "fmr:Displacement_xyz"
    },{
    "fmr:Name": "Solve samples.",
    "fmr:Analysis": "fmr:Static",
    "fmr:Conditioner": "fmr:Jacobi",
    "fmr:Solver": "fmr:PCG",
    "fmr:Initial_displacements_xyz": "nominal_displacements",

    "base_force_mag": {
      "fmr:Force_mag" : { "fmr:Reduce:Sum": "beam-base-nodeset" }
    }
  }],
  "fmr:Post": [{
    "fmr:File_name": "uq_straw_1_nominal.csv",
    "fmr:File_format": "fmr:CSV",
    "fmr:Field": [
      "node_number",
      "nominal_coordinates",
      "nominal_displacements"
    ]
    },{
    "fmr:File_name": "uq_straw_1_samples.csv",
    "fmr:File_format": "fmr:CSV",
    "fmr:Field": [
      "run_number",
      "base_force_mag",
      "beam_volume"
    ]
  },{
    "fmr:File_name": "uq_straw_1_samples_gmsh.csv",
    "fmr:File_format": "fmr:CSV",
    "fmr:Field": [
      "run_number",
      "base_force_mag",
      "beam_volume"
    ]
    }],
  "fmr:Runs": [{
    "fmr:Name": "Cantilever beam nominal solution",
    "fmr:Sims": [0],
    "fmr:Geom": [0],
    "fmr:Grid": [0],
    "fmr:Part": [0],
    "fmr:Mtrl": [0],
    "fmr:BCs": [[0,1]],
    "fmr:Solve": [0],
    "fmr:Post": [0],
    "fmr:Simulation_size": "fmr:XS",
    "fmr:Schedule": "fmr:Preallocate",
    "fmr:Cores_per_run": 1,
    "fmr:Duplicate_runs": "fmr:CPU_n",
    "fmr:Runs_n": 1
    },{ 
    "fmr:Name": "Cantilever beam sample solutions",
    "fmr:Sims": [0],
    "fmr:Geom": [0],
    "fmr:Grid": [0],
    "fmr:Part": [0],
    "fmr:Mtrl": [0],
    "fmr:BCs": [[0,1]],
    "fmr:Solve": [1],
    "fmr:Post": [1],
    "fmr:Simulation_size": "fmr:XS",
    "fmr:Schedule": "fmr:FIFO",
    "fmr:Cores_per_run": 1,
    "run_number": "fmr:Runs_ix",
    "fmr:Runs_n": {"sample_n": 0}
  },{ 
    "fmr:Name": "Cantilever beam sample solutions (Gmsh)",
    "fmr:Sims": [0],
    "fmr:Geom": [1],
    "fmr:Grid": [1],
    "fmr:Part": [0],
    "fmr:Mtrl": [0],
    "fmr:BCs": [[0,1]],
    "fmr:Solve": [1],
    "fmr:Post": [2],
    "fmr:Simulation_size": "fmr:XS",
    "fmr:Schedule": "fmr:FIFO",
    "fmr:Cores_per_run": 1,
    "run_number": "fmr:Runs_ix",
    "fmr:Runs_n": {"sample_n": 0}
  }]
 } ] }
