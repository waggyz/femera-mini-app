{ "fmr:Sims": {
  "TODO": "pym:nominal or fmr:to?, with pym:name implying Python read/write?",
    "fmr:Geom": {
      "fmr:geom:shape": "fmr:geom:block",
      "fmr:Data_type:Dimensions_xyz": {
        "pym:name": "dims", "pym:nominal": [1.000, 0.050, 0.050]
      },
      "fmr:Mtrl": {
        "fmr:mtrl:elastic:isotropic": {
          "fmr:Data_type:Youngs_modulus": {
            "pym:name": "youngs", "pym:nominal": 210e9
          },
          "fmr:Data_type:Poissons_ratio": {
            "pym:name": "poissons", "pym:nominal": 0.285
          }
        }
      },
      "fmr:Grid": {
        "fmr:grid:structured": true,
        "fmr:grid:cell": "fmr:grid:cell:block-6tet",
        "fmr:Data_type:Elem_type": "fmr:Data_type:Elem_type:Tet10",
        "fmr:Data_type:Grid_divs": [100, 5, 5],
        "fmr:grid:BCs": {
          "fmr:Data_type:Displacement_xyz": {
            "fmr:grid:node:at": "fmr:Data_type:Node_x_min",
            "fmr:to": 0.000
          },
          "fmr:Data_type:Displacement_z": {
            "fmr:grid:node:at": "fmr:Data_type:Node_x_max",
            "pym:name": "tip-displace-z", "pym:nominal": -0.010
          }
        }
      }
    },
    "fmr:Conditioner": {
      "fmr:conditioner:method": "fmr:solve:cond:jacobi"
    },
    "fmr:Runs": [
      {
        "fmr:Data_type:Runs_n": 1,
        "fmr:Solve": {
          "fmr:solve:method": "fmr:solve:pcg"
        },
        "fmr:Post": {
          "fmr:Data_type:Node_xyz": {
            "pym:name": "nominal-node-coordinates"
          },
          "fmr:Data_type:Displacement_xyz": {
            "pym:name": "nominal-displacements"
          }
        }
      },
      {
        "fmr:Data_type:Runs_n": {
          "pym:name": "sample_n"
        },
        "fmr:Solve": {
          "fmr:solve:method": "fmr:solve:pcg",
          "fmr:solve:initial-guess": {"pym:name": "nominal-displacements"}
        },
        "fmr:Post": {
          "fmr:Data_type:Displacement_mag": {
            "fmr:grid:node:at": "fmr:Data_type:Node_x_min",
            "fmr:math:reduce": "fmr:math:sum",
            "pym:name": "base-force-mag"
          }
        }
      }
    ]
  }
}
