{ "fmr:Sims": {
  "fmr:NOTE": "non-fmr: keys imply Python read/write values and parameters.",

  "fmr:Name": "Cantilever beam (uq_straw_1d)",
  "fmr:Sims_type": "fmr:Sims_type:UQ",
  "fmr:Version": "0.1.4",
    "fmr:Geom": {
      "fmr:Shape_type": "fmr:Shape_type:Block",
      "dims": {"fmr:Dimensions_xyz": [1.000, 0.050, 0.050] }
    },
    "fmr:Grid": {
      "fmr:Geom": 0,
      "fmr:Grid_structure": "fmr:Grid_structure:Cartesian",
      "fmr:Cell_type": "fmr:Cell_type:Block-6tet",
      "fmr:Elem_type": "fmr:Elem_type:Tet10",
      "fmr:Grid_divs": [100, 5, 5],
      "beam-base": {
        "fmr:Node_set": {
          "fmr:Node_at": "fmr:Node_x_min"
        }
      },
      "beam-tip": {
        "fmr:Node_set": {
          "fmr:Node_at": "fmr:Node_x_max"
        }
      }
    },
    "fmr:Mtrl": {
      "fmr:Grid": 0,
      "fmr:Mtrl_physics": "fmr:Mtrl_physics:Elastic-isotropic",
      "youngs": {"fmr:Youngs_modulus": 210e9 },
      "poissons": {"fmr:Poissons_ratio": 0.285 }
    },
    "fmr:BCs": [
      {
        "fmr:Node_set": "beam-base",
        "fmr:Displacement_xyz": [0.000, 0.000, 0.000]
      },
      {
        "fmr::Data_type:Node_set": "beam-tip",
        "tip-displace-z": {"fmr:Displacement_z": -0.010 }
      }
    ],
    "fmr:Solve": {
      "fmr:Conditioner": "fmr:Conditioner:Jacobi",
      "fmr:Solver": "fmr:Solver:PCG"
    },
    "fmr:Runs": [
      {
        "fmr:Name": "Cantilever beam nominal solution",
        "fmr:Runs_n": 1,
        "fmr:Post": {
          "nominal-node-coordinates": "fmr:Node_xyz",
          "nominal-displacements": "fmr:Displacement_xyz"
        }
      },
      {
        "fmr:Name": "Cantilever beam sample solutions",
        "sample_n": {"fmr:Runs_n": null},
        "fmr:Solve": {
          "fmr:Initial_displacements_xyz": "nominal-displacements"
        },
        "fmr:Post": {
          "base-force-mag": {
            "fmr:Force_mag": {
              "fmr:Reduce": "fmr:Reduce:Sum",
              "fmr:Node_set": "beam-base"
            }
          }
        }
      }
    ]
  }
}
